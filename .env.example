# Logto 會員登入：四個值都要填寫；全部留空時不啟用會員登入。
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# 自行產生至少 32 字元的隨機密鑰，例如 openssl rand -hex 32。
LOGTO_SESSION_SECRET=
# 本機 Docker Compose 可使用 http://localhost:4998/auth/callback。
# 回呼網址也必須加入 Logto 應用程式的允許清單。
LOGTO_REDIRECT_URI=

# 選填：Docker Compose 預設為 http://ollama:11434。
# OLLAMA_BASE_URL=http://ollama:11434
